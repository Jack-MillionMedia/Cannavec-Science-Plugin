# Cannavec Science — credentials template.
#
# Copy this to `.env` and fill in YOUR OWN keys. The real `.env` is git-ignored
# and is never committed. NCBI requires each user to use their own personal key
# (sharing/pooling one key is not allowed), so no key ever ships in this repo.
#
# Easiest setup:  python3 -m cannavec_science setup
#
# Get a free NCBI key (≈ 2 min):
#   1. https://account.ncbi.nlm.nih.gov/            (sign in / create a free account)
#   2. https://account.ncbi.nlm.nih.gov/settings/   → "API Key Management" → create
NCBI_API_KEY=
NCBI_EMAIL=

# Optional — only needed for the `discover --rerank-llm` semantic re-rank lift.
# ANTHROPIC_API_KEY=
